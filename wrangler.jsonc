{
  // A static site on Workers: no Worker code, just the built assets.
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "halo",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./apps/site/dist",
    // /docs/* and /playground are client routes: anything that isn't a file gets index.html.
    "not_found_handling": "single-page-application"
  }
}
