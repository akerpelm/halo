{
  "name": "halo-ui-react",
  "version": "0.1.0",
  "description": "Spring-physics toast and drawer for React. Frosted glass, accessible by default, built for agents.",
  "license": "MIT",
  "author": "Alex Kerpelman",
  "homepage": "https://haloui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akerpelm/halo.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/akerpelm/halo/issues",
  "keywords": [
    "react",
    "toast",
    "drawer",
    "sheet",
    "spring",
    "animation",
    "glass",
    "accessible",
    "sonner",
    "vaul"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "toast": [
        "./dist/toast.d.ts"
      ],
      "drawer": [
        "./dist/drawer.d.ts"
      ],
      "spring": [
        "./dist/spring.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./toast": {
      "import": {
        "types": "./dist/toast.d.ts",
        "default": "./dist/toast.js"
      },
      "require": {
        "types": "./dist/toast.d.cts",
        "default": "./dist/toast.cjs"
      }
    },
    "./drawer": {
      "import": {
        "types": "./dist/drawer.d.ts",
        "default": "./dist/drawer.js"
      },
      "require": {
        "types": "./dist/drawer.d.cts",
        "default": "./dist/drawer.cjs"
      }
    },
    "./spring": {
      "import": {
        "types": "./dist/spring.d.ts",
        "default": "./dist/spring.js"
      },
      "require": {
        "types": "./dist/spring.d.cts",
        "default": "./dist/spring.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "dev": "tsup --watch --onSuccess 'cp src/styles.css dist/styles.css'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test",
    "size": "node scripts/size.mjs",
    "size:check": "node scripts/size.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
